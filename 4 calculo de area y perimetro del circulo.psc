Algoritmo areayperímetrodeuncirculo
	Escribir "Para calcular el area ingrese el radio del círculo: "
	Leer radio
	Si radio>0 Entonces
		area=3.1416*radio^2
		Escribir "el area del cículo: ", area
	SiNo
		Escribir "Los datos no son correctos"
		
	FinSi
	Escribir "Para calcular el perimetro ingrese el radio del círculo: "
	Leer radio
	Si radio>0 Entonces
		perimetro=2*3.1416*radio
		Escribir "el perimetro del cículo: ", perimetro
	SiNo
		Escribir "Los datos no son correctos"
	FinSi
	
FinAlgoritmo
